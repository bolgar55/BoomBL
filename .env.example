# Токен Telegram-бота (@BotFather). Значение НЕ пишется в репозиторий —
# впишите его в свой локальный .env / переменные окружения Vercel.
TELEGRAM_BOT_TOKEN=

# Публичный HTTPS-адрес задеплоенной игры. Появляется после `vercel --prod`
# (например https://ваш-проект.vercel.app) — впишите его сюда и в переменные
# окружения Vercel. Используется ботом для кнопки WebApp (/start) и экраном
# Game Over для «Поделиться результатом».
GAME_URL=

# Номиналы доната в Telegram Stars через запятую, без пробелов и без валюты,
# например: 25,50,100
STARS_AMOUNTS=

# Хранилище лидерборда (api/leaderboard.js) — Redis, совместимый с REST API
# Upstash. Проще всего: в панели Vercel открыть Storage -> Create Database ->
# KV (это и есть Upstash под капотом), подключить к проекту — эти две
# переменные подставятся автоматически, вписывать вручную не нужно. Без них
# лидерборд просто отвечает 503 и не ломает остальную игру.
KV_REST_API_URL=
KV_REST_API_TOKEN=
